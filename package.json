{
  "name": "gta6-spoiler-shield",
  "version": "1.2.2",
  "private": true,
  "description": "Firefox add-on that blurs GTA VI content across the web.",
  "scripts": {
    "start": "web-ext run",
    "test": "node --test test/*.test.js",
    "lint": "web-ext lint --self-hosted",
    "test:e2e": "npm run build && node test/e2e/smoke.mjs",
    "check": "npm test && npm run lint",
    "build": "web-ext build --overwrite-dest",
    "sign": "web-ext sign --channel=unlisted",
    "release": "node scripts/release.mjs",
    "verify-xpi": "node scripts/verify-xpi.mjs"
  },
  "webExt": {
    "sourceDir": ".",
    "ignoreFiles": [
      "test",
      "scripts",
      "package.json",
      "package-lock.json",
      "updates.json",
      "CLAUDE.md",
      "README.md"
    ]
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "selenium-webdriver": "^4.51.0",
    "web-ext": "^10.8.0"
  }
}
